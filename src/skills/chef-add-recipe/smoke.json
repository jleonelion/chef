[
  {
    "id": "draft-needs-a-draft-file",
    "script": "scripts/add-recipe.mjs",
    "args": [
      "draft",
      "--kind",
      "text",
      "--source",
      "SKILL.md",
      "--draft",
      "missing-draft.json",
      "--dry-run"
    ],
    "expect": {
      "exit": 2,
      "status": "invalid-input"
    }
  },
  {
    "id": "rejects-non-http-url",
    "script": "scripts/add-recipe.mjs",
    "args": [
      "url",
      "--url",
      "file:///etc/hosts"
    ],
    "expect": {
      "exit": 2,
      "status": "invalid-input"
    }
  },
  {
    "id": "enrich-unknown-recipe-not-found",
    "script": "scripts/add-recipe.mjs",
    "args": [
      "enrich",
      "--slug",
      "no-such-recipe"
    ],
    "expect": {
      "exit": 2,
      "status": "not-found"
    }
  },
  {
    "id": "verify-needs-a-constraint",
    "script": "scripts/add-recipe.mjs",
    "args": [
      "verify",
      "--slug",
      "lemon-garlic-pasta"
    ],
    "expect": {
      "exit": 2,
      "status": "invalid-input"
    }
  }
]

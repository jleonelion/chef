  {
    "id": "chef-add-recipe-enriches-without-usda-key",
    "description": "A saved recipe is enriched straight away: allergen flags from the ingredient wording, and with no USDA key nutrition is \"not computed\" with a chef-setup hint and no numbers.",
    "env": {
      "CHEF_USDA_FDC_KEY": ""
    },
    "seed": [
      {
        "path": "draft.json",
        "content": "{\"title\":\"Buttermilk Pancakes\",\"servings\":4,\"ingredients\":[\"2 cups all-purpose flour\",\"2 large eggs\",\"2 cups buttermilk\",\"1 pinch salt\"],\"steps\":[\"Whisk.\",\"Cook on a griddle.\"]}"
      },
      {
        "path": "pasted.txt",
        "content": "Buttermilk pancakes. Synthetic test source.\n"
      }
    ],
    "command": [
      "node",
      "{skills}/chef-add-recipe/scripts/add-recipe.mjs",
      "draft",
      "--kind",
      "text",
      "--source",
      "{data_root}/pasted.txt",
      "--draft",
      "{data_root}/draft.json"
    ],
    "parse": "json",
    "assertions": [
      {
        "path": "$.status",
        "equals": "added"
      },
      {
        "path": "$.enrichment.dietary_flags",
        "equals": [
          "contains-dairy",
          "contains-egg",
          "contains-gluten",
          "contains-wheat"
        ]
      },
      {
        "path": "$.enrichment.nutrition",
        "equals": "not-computed"
      },
      {
        "path": "$.enrichment.reason",
        "equals": "not-connected"
      },
      {
        "path": "$.hint",
        "includes": "chef-setup"
      }
    ],
    "files": [
      {
        "path": "knowledge/wiki/recipes/buttermilk-pancakes.md",
        "assertions": [
          {
            "path": "$.content",
            "includes": "nutrition_status: not-computed"
          },
          {
            "path": "$.content",
            "includes": "- contains-egg"
          }
        ]
      }
    ]
  },

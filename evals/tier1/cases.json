    "parse": "json",
    "assertions": [
      {
        "path": "$.status",
        "equals": "ok"
      },
      {
        "path": "$.frontmatter.source_kind",
        "equals": "text"
      },
      {
        "path": "$.frontmatter.source_url",
        "absent": true
      },
      {
        "path": "$.body",
        "includes": "- 50 g rolled oats"
      }
    ]
  },

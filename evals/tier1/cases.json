      "LANG": "en_US.UTF-8",
      "LC_ALL": "",
      "LC_MEASUREMENT": ""
    },
    "seed": [
      {
        "path": "settings.json",
        "content": "{\"settings_version\": 1, \"future_key\": \"kept\"}\n"
      }
    ],
    "command": [
      "node",
      "{skills}/chef-setup/scripts/setup.mjs",
      "set",
      "--units",
      "metric",
      "--household-recipients",
      "cook@example.com, helper@example.com",
      "--calendar",
      "Family"
    ],
    "parse": "json",
    "assertions": [
      {
        "path": "$.status",
        "equals": "saved"
      },
      {
        "path": "$.settings.units",

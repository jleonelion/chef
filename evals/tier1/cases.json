[
  {
    "id": "chef-setup-creates-data-root",
    "description": "chef-setup init creates a git-initialised data root with a schema-version file and a git-ignored settings file.",
    "fixture": "none",
    "command": [
      "node",
      "{skills}/chef-setup/scripts/setup.mjs",
      "init"
    ],
    "parse": "json",
    "assertions": [
      {
        "path": "$.status",
        "equals": "created"
      },
      {
        "path": "$.schema_version",
        "equals": 1
      }
    ],
    "files": [
      {
        "path": "schema-version.json",
        "parse": "json",
        "assertions": [
          {
            "path": "$.schema_version",
            "equals": 1
          }
        ]
      },
      {
        "path": "settings.json",
        "parse": "json",
        "assertions": [
          {
            "path": "$.settings_version",
            "equals": 1
          }
        ]
      },
      {
        "path": ".gitignore",
        "assertions": [
          {
            "path": "$.content",
            "includes": "settings.json"
          }
        ]
      },
      {
        "path": ".git/HEAD",
        "assertions": [
          {
            "path": "$.content",
            "includes": "refs/heads/main"
          }
        ]
      }
    ]
  },
  {
    "id": "chef-setup-settings-missing-uses-defaults",
    "description": "With no settings.json, every v1 key falls back to its code default (units from locale) and no warning is shown.",
    "env": {
      "LANG": "en_US.UTF-8",
      "LC_ALL": "",
      "LC_MEASUREMENT": ""
    },
    "command": [
      "node",
      "{skills}/chef-setup/scripts/setup.mjs",
      "settings"
    ],
    "parse": "json",
    "assertions": [
      {
        "path": "$.status",
        "equals": "missing"
      },
      {
        "path": "$.settings.household_recipients",
        "equals": []
      },
      {
        "path": "$.settings.trusted_receipt_senders",
        "equals": []
      },
      {
        "path": "$.settings.units",
        "equals": "us"
      },
      {
        "path": "$.settings.calendar",
        "equals": null
      },
      {
        "path": "$.warning",
        "absent": true
      }
    ]
  },

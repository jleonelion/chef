  {
    "id": "food-inventory-receipt-text-yields-items",
    "description": "Receipt text becomes inventory items: a new item is placed by name, a targeted item is added to, and the rollup page is regenerated.",
    "seed": [
      {
        "path": "../receipt.txt",
        "content": "Example Market, 2026-01-15\n- 2 lb bananas — $1.38\n- 1 gal whole milk — $3.49 -> fridge.dairy.whole_milk\n"
      }
    ],
    "command": [
      "node",
      "{skills}/chef-food-inventory/scripts/inventory.mjs",
      "add-receipt",
      "--transcript-file",
      "{data_root}/../receipt.txt",
      "--source",
      "text",
      "--date",

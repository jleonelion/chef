    "files": [
      {
        "path": "settings.json",
        "parse": "json",
        "assertions": [
          {
            "path": "$.future_key",
            "equals": "kept"
          },
          {
            "path": "$.settings_version",
            "equals": 1
          },
          {
            "path": "$.units",
            "equals": "metric"
          },
          {
            "path": "$.calendar",
            "equals": "Family"
          },
          {
            "path": "$.household_recipients",
            "equals": [
              "cook@example.com",
              "helper@example.com"
            ]
          }
        ]
      },
      {
        "path": ".gitignore",
        "assertions": [
          {
            "path": "$.content",
            "includes": "settings.json"
          }
        ]
      }

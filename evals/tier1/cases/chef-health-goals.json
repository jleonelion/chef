[
  {
    "id": "chef-health-goals-no-goal-no-health-output",
    "description": "With no goal declared, the weekly report is dormant with no health output, even when meals are logged, and nothing is written.",
    "seed": [
      {
        "path": "data/meal-log/log.json",
        "seedFile": "evals/tier1/inputs/chef-health-goals-no-goal-no-health-output/log.json"
      }
    ],
    "command": [
      "node",
      "{skills}/chef-health-goals/scripts/health-goals.mjs",
      "report",
      "--week-start",
      "2026-01-19"
    ],
    "parse": "json",
    "assertions": [
      {
        "path": "$.status",
        "equals": "dormant"
      },
      {
        "path": "$.footer",
        "absent": true
      },
      {
        "path": "$.progress",
        "absent": true
      }
    ],
    "git": {
      "headUnchanged": true,
      "clean": true
    }
  },
  {
    "id": "chef-health-goals-weekly-report-from-fixture",
    "description": "The weekly report averages fully measured days from the meal log against the goal targets, lists unmeasured entries without estimating, ends with the not-medical-advice footer, and writes nothing.",
    "seed": [
      {
        "path": "data/health-goals/goals.json",
        "content": "{\"goal\":\"Lower sodium\",\"targets\":{\"sodium\":{\"max\":2300},\"protein\":{\"min\":90}},\"set\":\"2026-01-10\",\"updated\":\"2026-01-10\"}\n"
      },
      {
        "path": "data/meal-log/log.json",
        "seedFile": "evals/tier1/inputs/chef-health-goals-weekly-report-from-fixture/log.json"
      }
    ],
    "command": [
      "node",
      "{skills}/chef-health-goals/scripts/health-goals.mjs",
      "report",
      "--week-start",
      "2026-01-19"
    ],
    "parse": "json",
    "assertions": [
      {
        "path": "$.status",
        "equals": "report"
      },
      {
        "path": "$.week_end",
        "equals": "2026-01-25"
      },
      {
        "path": "$.goal",
        "equals": "Lower sodium"
      },
      {
        "path": "$.days[0].totals.sodium",
        "equals": 2100
      },
      {
        "path": "$.days[2].status",
        "equals": "incomplete"
      },
      {
        "path": "$.days[3].status",
        "equals": "not-logged"
      },
      {
        "path": "$.unmeasured[0].id",
        "equals": "2026-01-21-dinner-chickpea-spinach-stew"
      },
      {
        "path": "$.progress[0]",
        "equals": {
          "nutrient": "sodium",
          "max": 2300,
          "daily_average": 2600,
          "days_on_target": 1,
          "days_measured": 2
        }
      },
      {
        "path": "$.progress[1]",
        "equals": {
          "nutrient": "protein",
          "min": 90,
          "daily_average": 45,
          "days_on_target": 0,
          "days_measured": 2
        }
      },
      {
        "path": "$.footer",
        "equals": "Chef gives general information, not medical advice."
      }
    ],
    "git": {
      "headUnchanged": true,
      "clean": true
    }
  },
  {
    "id": "chef-health-goals-set-goal-shows-training-notice-once",
    "description": "Declaring the first goal saves the one goals store and records the shared training-setting notice in the same commit; a second set does not repeat the notice.",
    "steps": [
      {
        "command": [
          "node",
          "{skills}/chef-health-goals/scripts/health-goals.mjs",
          "set",
          "--goal",
          "Lower sodium",
          "--max",
          "sodium=2300"
        ],
        "parse": "json",
        "assertions": [
          {
            "path": "$.status",
            "equals": "saved"
          },
          {
            "path": "$.notice",
            "includes": "Help improve our AI models"
          },
          {
            "path": "$.footer",
            "equals": "Chef gives general information, not medical advice."
          }
        ]
      }
    ],
    "command": [
      "node",
      "{skills}/chef-health-goals/scripts/health-goals.mjs",
      "set",
      "--goal",
      "Lower sodium",
      "--max",
      "sodium=2000",
      "--min",
      "fiber=30"
    ],
    "parse": "json",
    "assertions": [
      {
        "path": "$.status",
        "equals": "saved"
      },
      {
        "path": "$.notice",
        "absent": true
      }
    ],
    "files": [
      {
        "path": "data/health-goals/goals.json",
        "parse": "json",
        "assertions": [
          {
            "path": "$.targets",
            "equals": {
              "sodium": {
                "max": 2000
              },
              "fiber": {
                "min": 30
              }
            }
          }
        ]
      },
      {
        "path": "data/notices.json",
        "parse": "json",
        "assertions": [
          {
            "path": "$.training-setting",
            "absent": false
          }
        ]
      }
    ],
    "git": {
      "clean": true
    }
  }
]

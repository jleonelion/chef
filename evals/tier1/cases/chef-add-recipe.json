    "git": {
      "clean": true
    }
  },
  {
    "id": "chef-add-recipe-nutrition-rolls-up-sub-recipe",
    "description": "A recipe that links a complete sub-recipe by slug counts its stored per-serving nutrition, scaled by the amount used against the sub-recipe's yield, and takes its dietary flags; the sub-recipe's ingredients are never copied.",
    "env": {
      "CHEF_USDA_FDC_KEY": "tier1-not-a-real-key",
      "CHEF_FDC_CACHE": "1"
    },
    "seed": [
      {
        "path": "cache/fdc/food/169736.json",
        "content": "{\"fdcId\": 169736, \"description\": \"Pasta, dry, enriched\", \"dataType\": \"SR Legacy\", \"foodPortions\": [{\"amount\": 1, \"modifier\": \"cup shells\", \"gramWeight\": 64}, {\"amount\": 2, \"modifier\": \"oz\", \"gramWeight\": 57}, {\"amount\": 1, \"modifier\": \"cup rotini\", \"gramWeight\": 96}, {\"amount\": 1, \"modifier\": \"cup elbows\", \"gramWeight\": 122}, {\"amount\": 1, \"modifier\": \"cup spaghetti\", \"gramWeight\": 91}, {\"amount\": 1, \"modifier\": \"cup penne\", \"gramWeight\": 95}, {\"amount\": 1, \"modifier\": \"cup farfalle\", \"gramWeight\": 81}, {\"amount\": 1, \"modifier\": \"cup lasagna\", \"gramWeight\": 90}], \"foodNutrients\": [{\"nutrient\": {\"id\": 1008}, \"amount\": 371}, {\"nutrient\": {\"id\": 1003}, \"amount\": 13.04}, {\"nutrient\": {\"id\": 1004}, \"amount\": 1.51}, {\"nutrient\": {\"id\": 1005}, \"amount\": 74.67}, {\"nutrient\": {\"id\": 1079}, \"amount\": 3.2}, {\"nutrient\": {\"id\": 2000}, \"amount\": 2.67}, {\"nutrient\": {\"id\": 1093}, \"amount\": 6}, {\"nutrient\": {\"id\": 1258}, \"amount\": 0.277}, {\"nutrient\": {\"id\": 1253}, \"amount\": 0}]}"
      },
      {
        "path": "knowledge/wiki/recipes/basil-pesto.md",
        "seedFile": "evals/tier1/inputs/chef-add-recipe-nutrition-rolls-up-sub-recipe/basil-pesto.md"
      },
      {
        "path": "knowledge/wiki/recipes/pesto-spaghetti.md",
        "seedFile": "evals/tier1/inputs/chef-add-recipe-nutrition-rolls-up-sub-recipe/pesto-spaghetti.md"
      }
    ],
    "command": [
      "node",
      "{skills}/chef-add-recipe/scripts/add-recipe.mjs",
      "enrich",
      "--slug",
      "pesto-spaghetti"
    ],
    "parse": "json",
    "assertions": [
      {
        "path": "$.status",
        "equals": "enriched"
      },
      {
        "path": "$.recipes[0].nutrition",
        "equals": "complete"
      },
      {
        "path": "$.recipes[0].dietary_flags",
        "equals": [
          "contains-dairy",
          "contains-gluten",
          "contains-tree-nuts",
          "contains-wheat"
        ]
      }
    ],
    "files": [
      {
        "path": "knowledge/wiki/recipes/pesto-spaghetti.md",
        "assertions": [
          {
            "path": "$.content",
            "includes": "calories: 571"
          },
          {
            "path": "$.content",
            "includes": "1/2 cup [[basil-pesto]]: sub-recipe basil-pesto, 2 servings"
          }
        ]
      }
    ],
    "git": {
      "clean": true
    }
  },
  {
    "id": "chef-add-recipe-dry-run-keeps-amounts-with-conversion-on",
    "description": "add-recipe always shows amounts as written, even with convert_recipe_units on.",
    "seed": [
      {
        "path": "settings.json",
        "content": "{\"settings_version\":1,\"units\":\"metric\",\"convert_recipe_units\":true}\n"
      },
      {
        "path": "draft.json",
        "content": "{\"title\": \"Milk Toast\", \"ingredients\": [\"1 cup milk\", \"2 slices bread\"], \"steps\": [\"Bake at 350°F.\"]}"
      },
      {
        "path": "pasted.txt",
        "content": "Milk toast. Synthetic test source.\n"
      }
    ],
    "command": [
      "node",
      "{skills}/chef-add-recipe/scripts/add-recipe.mjs",
      "draft",
      "--kind",
      "text",
      "--source",
      "{data_root}/pasted.txt",
      "--draft",
      "{data_root}/draft.json",
      "--dry-run"
    ],
    "parse": "json",
    "assertions": [
      {
        "path": "$.status",
        "equals": "would-add"
      },
      {
        "path": "$.body",
        "includes": "- 1 cup milk\n"
      },
      {
        "path": "$.body",
        "includes": "Bake at 350°F.\n"
      }
    ],
    "git": {
      "headUnchanged": true,
      "clean": true
    }
  }

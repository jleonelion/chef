      },
      {
        "path": "$.items.[?(@item=='garlic')].amount",
        "equals": 6
      },
      {
        "path": "$.items.[?(@item=='garlic')].unit",
        "equals": "clove"
      },
      {
        "path": "$.items.[?(@item=='crushed tomatoes')].amount",
        "equals": 600
      },
      {
        "path": "$.items.[?(@item=='spinach')].amount",
        "equals": 225
      },
      {
        "path": "$.items.[?(@item=='spinach')].on_hand.unit",
        "equals": "bunch"
      },
      {
        "path": "$.covered[0].item",
        "equals": "spaghetti"
      },
      {
        "path": "$.dietary.nudge",
        "includes": "No dietary constraints recorded"
      },
      {
        "path": "$.text",
        "includes": "- 6 clove garlic"
      },
      {
        "path": "$.items.[?(@item=='crushed tomatoes')].unit",
        "equals": "g"
      },
      {
        "path": "$.text",
        "includes": "- 225 g spinach (on hand: 1 bunch)"
      },
      {
        "path": "$.text",
        "includes": "- 1.5 tsp ground cumin"
      },
      {
        "path": "$.delivery.mode",
        "equals": "chat"
      }

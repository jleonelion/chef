    "id": "chef-shopping-lists-combines-plan-minus-inventory-chat-only",
    "description": "A saved plan becomes one list: quantities scaled to planned servings and combined across meals, inventory subtracted in convertible units only, quantities shown in metric per the units setting, and with no household recipients the list is shown in chat with nothing written.",
    "seed": [
      {
        "path": "knowledge/wiki/meal-plans/2026-01-19.md",
        "seedFile": "evals/tier1/inputs/chef-shopping-lists-combines-plan-minus-inventory-chat-only/2026-01-19.md"
      },
      {
        "path": "data/food-inventory/current.json",
        "seedFile": "evals/tier1/inputs/chef-shopping-lists-combines-plan-minus-inventory-chat-only/current.json"
      },
      {
        "path": "settings.json",
        "content": "{\"settings_version\":1,\"units\":\"metric\"}\n"
      }
    ],
    "command": [
      "node",
      "{skills}/chef-shopping-lists/scripts/shopping-lists.mjs",
      "build"
    ],
    "parse": "json",
    "assertions": [
      {
        "path": "$.status",
        "equals": "built"
      },
      {
        "path": "$.week_start",
        "equals": "2026-01-19"
      },
      {
        "path": "$.items.[?(@item=='chickpeas')].amount",

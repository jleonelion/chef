[
  {
    "id": "chef-recipe-decisions-rejected-not-reproposed",
    "description": "A recipe the user rejected in chat is a durable decision: proposing it again returns the earlier rejection and writes nothing.",
    "env": {
      "CHEF_USDA_FDC_KEY": ""
    },
    "seed": [
      {
        "path": "../draft.json",
        "content": "{\"title\":\"Mushroom Barley Soup\",\"servings\":4,\"total_minutes\":50,\"cuisine\":\"american\",\"ingredients\":[\"200 g mushrooms\",\"100 g pearl barley\",\"1 l vegetable stock\"],\"steps\":[\"Simmer everything for 40 minutes.\"]}"
      }
    ],
    "steps": [
      {
        "command": [
          "node",
          "{skills}/chef-recipe-decisions/scripts/recipe-decisions.mjs",
          "propose",
          "--draft",
          "{data_root}/../draft.json"
        ]
      },
      {
        "command": [
          "node",
          "{skills}/chef-recipe-decisions/scripts/recipe-decisions.mjs",
          "decide",
          "--id",
          "mushroom-barley-soup",
          "--outcome",
          "reject",
          "--reason",
          "Not a fan of barley"
        ]
      }
    ],
    "command": [
      "node",
      "{skills}/chef-recipe-decisions/scripts/recipe-decisions.mjs",
      "propose",
      "--draft",
      "{data_root}/../draft.json"
    ],
    "parse": "json",
    "assertions": [
      {
        "path": "$.status",
        "equals": "already-rejected"
      },
      {
        "path": "$.reason",
        "equals": "Not a fan of barley"
      }
    ],
    "files": [
      {
        "path": "data/recipe-decisions/proposals.json",
        "parse": "json",
        "assertions": [
          {
            "path": "$.proposals.mushroom-barley-soup.decisions.length",
            "equals": 1
          },
          {
            "path": "$.proposals.mushroom-barley-soup.decisions[0].outcome",
            "equals": "reject"
          }
        ]
      }
    ],
    "git": {
      "clean": true
    }
  },
  {
    "id": "chef-recipe-decisions-publication-idempotent",
    "description": "Accepting publishes the recipe once; publishing again changes nothing.",
    "env": {
      "CHEF_USDA_FDC_KEY": ""
    },
    "seed": [
      {
        "path": "../draft.json",
        "content": "{\"title\":\"Mushroom Barley Soup\",\"servings\":4,\"total_minutes\":50,\"cuisine\":\"american\",\"ingredients\":[\"200 g mushrooms\",\"100 g pearl barley\",\"1 l vegetable stock\"],\"steps\":[\"Simmer everything for 40 minutes.\"]}"
      }
    ],
    "steps": [
      {
        "command": [
          "node",
          "{skills}/chef-recipe-decisions/scripts/recipe-decisions.mjs",
          "propose",
          "--draft",
          "{data_root}/../draft.json"
        ]
      },
      {
        "command": [
          "node",
          "{skills}/chef-recipe-decisions/scripts/recipe-decisions.mjs",
          "decide",
          "--id",
          "mushroom-barley-soup",
          "--outcome",
          "accept"
        ]
      },
      {
        "command": [
          "node",
          "{skills}/chef-recipe-decisions/scripts/recipe-decisions.mjs",
          "publish",
          "--id",
          "mushroom-barley-soup"
        ]
      }
    ],
    "command": [
      "node",
      "{skills}/chef-recipe-decisions/scripts/recipe-decisions.mjs",
      "publish"
    ],
    "parse": "json",
    "assertions": [
      {
        "path": "$.status",
        "equals": "unchanged"
      }
    ],
    "files": [
      {
        "path": "knowledge/wiki/recipes/mushroom-barley-soup.md",
        "assertions": [
          {
            "path": "$.content",
            "includes": "source_kind: proposal"
          },
          {
            "path": "$.content",
            "includes": "dietary_flags:"
          }
        ]
      },
      {
        "path": "data/recipe-decisions/proposals.json",
        "parse": "json",
        "assertions": [
          {
            "path": "$.proposals.mushroom-barley-soup.published.path",
            "equals": "knowledge/wiki/recipes/mushroom-barley-soup.md"
          },
          {
            "path": "$.proposals.mushroom-barley-soup.decisions.length",
            "equals": 1
          }
        ]
      }
    ],
    "git": {
      "clean": true
    }
  },
  {
    "id": "chef-recipe-decisions-standing-rule-auto-rejects",
    "description": "A standing auto-reject rule decides a matching proposal without asking, and records which rule did it.",
    "env": {
      "CHEF_USDA_FDC_KEY": ""
    },
    "seed": [
      {
        "path": "../draft.json",
        "content": "{\"title\":\"Mushroom Barley Soup\",\"servings\":4,\"total_minutes\":50,\"cuisine\":\"american\",\"ingredients\":[\"200 g mushrooms\",\"100 g pearl barley\",\"1 l vegetable stock\"],\"steps\":[\"Simmer everything for 40 minutes.\"]}"
      }
    ],
    "steps": [
      {
        "command": [
          "node",
          "{skills}/chef-recipe-decisions/scripts/recipe-decisions.mjs",
          "rule-add",
          "--action",
          "reject",
          "--id",
          "no-barley",
          "--reason",
          "No barley",
          "--text",
          "barley"
        ]
      }
    ],
    "command": [
      "node",
      "{skills}/chef-recipe-decisions/scripts/recipe-decisions.mjs",
      "propose",
      "--draft",
      "{data_root}/../draft.json"
    ],
    "parse": "json",
    "assertions": [
      {
        "path": "$.status",
        "equals": "auto-rejected"
      },
      {
        "path": "$.rule.id",
        "equals": "no-barley"
      }
    ],
    "files": [
      {
        "path": "data/recipe-decisions/proposals.json",
        "parse": "json",
        "assertions": [
          {
            "path": "$.proposals.mushroom-barley-soup.decisions[0].by",
            "equals": "rule:no-barley"
          }
        ]
      }
    ],
    "git": {
      "clean": true
    }
  },
  {
    "id": "chef-recipe-decisions-retired-recipe-leaves-search",
    "description": "A retired recipe keeps its page but leaves recipe search; search reports how many it hid.",
    "grounding": {
      "recipes": [
        "lemon-garlic-pasta"
      ]
    },
    "steps": [
      {
        "command": [
          "node",
          "{skills}/chef-recipe-decisions/scripts/recipe-decisions.mjs",
          "retire",
          "--slug",
          "lemon-garlic-pasta",
          "--reason",
          "Made it too often"
        ]
      }
    ],
    "command": [
      "node",
      "{skills}/chef-recipe-search/scripts/recipe-search.mjs",
      "search",
      "--ingredient",
      "garlic"
    ],
    "parse": "json",
    "assertions": [
      {
        "path": "$.recipes[*].slug",
        "equals": "chickpea-spinach-stew"
      },
      {
        "path": "$.retired_hidden",
        "equals": 1
      }
    ],
    "files": [
      {
        "path": "knowledge/wiki/recipes/lemon-garlic-pasta.md",
        "assertions": [
          {
            "path": "$.content",
            "includes": "lifecycle: retired"
          }
        ]
      }
    ],
    "git": {
      "clean": true
    }
  },
  {
    "id": "chef-recipe-decisions-restore-returns-recipe",
    "description": "Retirement is reversible: a restored recipe is back in search.",
    "grounding": {
      "recipes": [
        "lemon-garlic-pasta"
      ]
    },
    "steps": [
      {
        "command": [
          "node",
          "{skills}/chef-recipe-decisions/scripts/recipe-decisions.mjs",
          "retire",
          "--slug",
          "lemon-garlic-pasta"
        ]
      },
      {
        "command": [
          "node",
          "{skills}/chef-recipe-decisions/scripts/recipe-decisions.mjs",
          "restore",
          "--slug",
          "lemon-garlic-pasta"
        ]
      }
    ],
    "command": [
      "node",
      "{skills}/chef-recipe-search/scripts/recipe-search.mjs",
      "search",
      "--ingredient",
      "spaghetti"
    ],
    "parse": "json",
    "assertions": [
      {
        "path": "$.recipes[0].slug",
        "equals": "lemon-garlic-pasta"
      },
      {
        "path": "$.retired_hidden",
        "absent": true
      }
    ],
    "git": {
      "clean": true
    }
  },
  {
    "id": "chef-recipe-decisions-auto-approve-dietary-conflict-stays-open",
    "description": "A standing auto-approve rule cannot accept or publish a proposal containing a declared allergen; the proposal stays open with the gate reasons.",
    "env": {
      "CHEF_USDA_FDC_KEY": ""
    },
    "seed": [
      {
        "path": "knowledge/wiki/household/dietary-ruleset.md",
        "seedFile": "evals/tier1/inputs/chef-recipe-decisions-auto-approve-dietary-conflict-stays-open/dietary-ruleset.md"
      },
      {
        "path": "../draft.json",
        "content": "{\"title\":\"Creamy Vegetable Soup\",\"ingredients\":[\"2 cups vegetables\",\"1 cup milk\"],\"steps\":[\"Simmer.\"]}"
      }
    ],
    "steps": [
      {
        "command": [
          "node",
          "{skills}/chef-recipe-decisions/scripts/recipe-decisions.mjs",
          "rule-add",
          "--action",
          "approve",
          "--id",
          "always-soup",
          "--reason",
          "Always add soups",
          "--text",
          "soup"
        ]
      },
      {
        "command": [
          "node",
          "{skills}/chef-recipe-decisions/scripts/recipe-decisions.mjs",
          "propose",
          "--draft",
          "{data_root}/../draft.json"
        ],
        "parse": "json",
        "assertions": [
          {
            "path": "$.status",
            "equals": "proposed"
          },
          {
            "path": "$.state",
            "equals": "open"
          },
          {
            "path": "$.reasons[0].constraint",
            "equals": "dairy"
          }
        ]
      }
    ],
    "command": [
      "node",
      "{skills}/chef-recipe-search/scripts/recipe-search.mjs",
      "search",
      "--query",
      "creamy"
    ],
    "parse": "json",
    "assertions": [
      {
        "path": "$.count",
        "equals": 0
      }
    ],
    "files": [
      {
        "path": "data/recipe-decisions/proposals.json",
        "parse": "json",
        "assertions": [
          {
            "path": "$.proposals.creamy-vegetable-soup.decisions",
            "equals": []
          },
          {
            "path": "$.proposals.creamy-vegetable-soup.gate_reasons[0].why",
            "equals": "flagged"
          },
          {
            "path": "$.proposals.creamy-vegetable-soup.published",
            "absent": true
          }
        ]
      }
    ],
    "git": {
      "clean": true
    }
  },
  {
    "id": "chef-recipe-decisions-publish-dietary-conflict-refused-cleanly",
    "description": "Publishing an accepted proposal that conflicts with a hard constraint is refused with reasons and leaves the data-root commit and worktree unchanged.",
    "env": {
      "CHEF_USDA_FDC_KEY": ""
    },
    "seed": [
      {
        "path": "knowledge/wiki/household/dietary-ruleset.md",
        "seedFile": "evals/tier1/inputs/chef-recipe-decisions-publish-dietary-conflict-refused-cleanly/dietary-ruleset.md"
      },
      {
        "path": "data/recipe-decisions/proposals.json",
        "content": "{\"proposals\":{\"sesame-noodles\":{\"id\":\"sesame-noodles\",\"slug\":\"sesame-noodles\",\"title\":\"Sesame Noodles\",\"proposed\":\"2026-01-15\",\"draft\":{\"title\":\"Sesame Noodles\",\"ingredients\":[\"200 g noodles\",\"1 tbsp sesame oil\"],\"steps\":[\"Toss.\"]},\"decisions\":[{\"outcome\":\"accept\",\"date\":\"2026-01-15\",\"by\":\"user\"}]}}}\n"
      }
    ],
    "command": [
      "node",
      "{skills}/chef-recipe-decisions/scripts/recipe-decisions.mjs",
      "publish",
      "--id",
      "sesame-noodles"
    ],
    "parse": "json",
    "expectedStatus": 2,
    "git": {
      "headUnchanged": true,
      "clean": true
    },
    "assertions": [
      {
        "path": "$.status",
        "equals": "refused"
      },
      {
        "path": "$.reason",
        "includes": "confirmation"
      },
      {
        "path": "$.blocked[0].reasons[0].constraint",
        "equals": "sesame"
      }
    ]
  },

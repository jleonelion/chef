  {
    "id": "chef-setup-set-preserves-unknown-keys",
    "description": "Change-settings writes the new values and keeps keys it does not know.",
    "env": {
      "LANG": "en_US.UTF-8",
      "LC_ALL": "",
      "LC_MEASUREMENT": ""
    },
    "seed": [
      {
        "path": "settings.json",
        "content": "{\"settings_version\": 1, \"future_key\": \"kept\"}\n"
      }
    ],
    "command": [
      "node",
      "{skills}/chef-setup/scripts/setup.mjs",
      "set",
      "--units",
      "metric",
      "--household-recipients",
      "cook@example.com, helper@example.com",
      "--calendar",
      "Family"
    ],
    "parse": "json",
    "assertions": [
      {
        "path": "$.status",
        "equals": "saved"
      },
      {
        "path": "$.settings.units",
        "equals": "metric"
      },
      {
        "path": "$.side_effects",
        "equals": [
          "recreate-delivery-tasks"
        ]
      }
    ],
    "files": [
      {
        "path": "settings.json",
        "parse": "json",
        "assertions": [
          {
            "path": "$.future_key",
            "equals": "kept"
          },
          {
            "path": "$.settings_version",
            "equals": 2
          },
          {
            "path": "$.diagnostics",
            "equals": {
              "trace": "on"
            }
          },
          {
            "path": "$.units",
            "equals": "metric"
          },
          {
            "path": "$.calendar",
            "equals": "Family"
          },
          {
            "path": "$.household_recipients",
            "equals": [
              "cook@example.com",
              "helper@example.com"
            ]
          }
        ]
      },
      {
        "path": ".gitignore",
        "assertions": [
          {
            "path": "$.content",
            "includes": "settings.json"
          }
        ]
      }
    ],
    "git": {
      "clean": true
    }
  },
  {
    "id": "chef-setup-units-change-regenerates-inventory-page",
    "description": "Changing units rewrites the generated inventory page in the new system and commits it; the inventory store keeps its own units.",
    "command": [
      "node",
      "{skills}/chef-setup/scripts/setup.mjs",
      "set",
      "--units",
      "metric"
    ],
    "parse": "json",
    "assertions": [
      {
        "path": "$.status",
        "equals": "saved"
      },
      {
        "path": "$.changed",
        "equals": [
          "units"
        ]
      },
      {
        "path": "$.inventory_page.status",
        "equals": "regenerated"
      }
    ],
    "files": [
      {
        "path": "knowledge/wiki/household/current-inventory.md",
        "assertions": [
          {
            "path": "$.content",
            "includes": "- jasmine rice: 925 g"
          },
          {
            "path": "$.content",
            "includes": "- whole milk: 3.8 l (expires 2026-01-21)"
          }
        ]
      },
      {
        "path": "data/food-inventory/current.json",
        "parse": "json",
        "assertions": [
          {
            "path": "$.fridge.dairy.whole_milk.unit",
            "equals": "gal"
          }
        ]
      }
    ],
    "git": {
      "clean": true
    }
  },
  {
    "id": "chef-setup-set-refuses-invalid-file-without-rewrite",
    "description": "Change-settings never silently overwrites a broken settings.json.",
    "env": {
      "LANG": "en_US.UTF-8",
      "LC_ALL": "",
      "LC_MEASUREMENT": ""
    },
    "seed": [
      {
        "path": "settings.json",
        "content": "not json\n"
      }
    ],
    "command": [
      "node",
      "{skills}/chef-setup/scripts/setup.mjs",
      "set",
      "--units",
      "metric"
    ],
    "parse": "json",
    "expectedStatus": 2,
    "assertions": [
      {
        "path": "$.status",
        "equals": "refused"
      },
      {
        "path": "$.content",
        "equals": "not json\n"
      }
    ],
    "files": [
      {
        "path": "settings.json",
        "assertions": [
          {
            "path": "$.content",
            "equals": "not json\n"
          }
        ]
      }
    ],
    "git": {
      "headUnchanged": true,
      "clean": true
    }
  },
  {

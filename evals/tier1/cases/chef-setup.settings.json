[
  {
    "id": "chef-setup-creates-data-root",
    "description": "chef-setup init creates a git-initialised data root with a schema-version file and a git-ignored settings file.",
    "fixture": "none",
    "command": [
      "node",
      "{skills}/chef-setup/scripts/setup.mjs",
      "init"
    ],
    "parse": "json",
    "assertions": [
      {
        "path": "$.status",
        "equals": "created"
      },
      {
        "path": "$.schema_version",
        "equals": 1
      }
    ],
    "files": [
      {
        "path": "schema-version.json",
        "parse": "json",
        "assertions": [
          {
            "path": "$.schema_version",
            "equals": 1
          }
        ]
      },
      {
        "path": "settings.json",
        "parse": "json",
        "assertions": [
          {
            "path": "$.settings_version",
            "equals": 2
          }
        ]
      },
      {
        "path": ".gitignore",
        "assertions": [
          {
            "path": "$.content",
            "includes": "settings.json"
          }
        ]
      },
      {
        "path": ".git/HEAD",
        "assertions": [
          {
            "path": "$.content",
            "includes": "refs/heads/main"
          }
        ]
      }
    ],
    "git": {
      "clean": true
    }
  },
  {
    "id": "chef-setup-settings-missing-uses-defaults",
    "description": "With no settings.json, every v1 key falls back to its code default (units from locale) and no warning is shown.",
    "env": {
      "LANG": "en_US.UTF-8",
      "LC_ALL": "",
      "LC_MEASUREMENT": ""
    },
    "command": [
      "node",
      "{skills}/chef-setup/scripts/setup.mjs",
      "settings"
    ],
    "parse": "json",
    "assertions": [
      {
        "path": "$.status",
        "equals": "missing"
      },
      {
        "path": "$.settings.household_recipients",
        "equals": []
      },
      {
        "path": "$.settings.trusted_receipt_senders",
        "equals": []
      },
      {
        "path": "$.settings.units",
        "equals": "us"
      },
      {
        "path": "$.settings.calendar",
        "equals": null
      },
      {
        "path": "$.settings.convert_recipe_units",
        "equals": false
      },
      {
        "path": "$.warning",
        "absent": true
      }
    ],
    "git": {
      "headUnchanged": true,
      "clean": true
    }
  },
  {
    "id": "chef-setup-set-convert-recipe-units",
    "description": "set --convert-recipe-units true turns on recipe conversion and stores a boolean; other settings are untouched.",
    "seed": [
      {
        "path": "settings.json",
        "content": "{\"settings_version\":1,\"units\":\"metric\"}\n"
      }
    ],
    "command": [
      "node",
      "{skills}/chef-setup/scripts/setup.mjs",
      "set",
      "--convert-recipe-units",
      "true"
    ],
    "parse": "json",
    "assertions": [
      {
        "path": "$.status",
        "equals": "saved"
      },
      {
        "path": "$.changed",
        "equals": [
          "convert_recipe_units"
        ]
      },
      {
        "path": "$.inventory_page",
        "absent": true
      }
    ],
    "files": [
      {
        "path": "settings.json",
        "parse": "json",
        "assertions": [
          {
            "path": "$.convert_recipe_units",
            "equals": true
          },
          {
            "path": "$.units",
            "equals": "metric"
          }
        ]
      }
    ],
    "git": {
      "headUnchanged": true,
      "clean": true
    }
  },
  {
    "id": "chef-setup-settings-units-default-from-locale",

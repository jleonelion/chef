  },
  {
    "id": "chef-setup-set-refuses-schema-mismatch",
    "description": "A writing skill refuses to write to a data root on a different schema version and points the user at update Chef.",
    "seed": [
      {
        "path": "schema-version.json",
        "content": "{\"schema_version\":2}\n"
      },
      {
        "path": "settings.json",
        "content": "{\"settings_version\":1}\n"
      }
    ],
    "command": [
      "node",
      "{skills}/chef-setup/scripts/setup.mjs",
      "set",
      "--units",
      "metric"
    ],
    "parse": "json",
    "expectedStatus": 2,
    "assertions": [
      {
        "path": "$.status",
        "equals": "refused"
      },
      {
        "path": "$.reason",
        "includes": "update Chef"
      },
      {
        "path": "$.schema_version",
        "equals": 2
      },
      {
        "path": "$.expected_schema_version",
        "equals": 1
      }
    ],
    "files": [
      {
        "path": "settings.json",
        "assertions": [
          {
            "path": "$.content",
            "equals": "{\"settings_version\":1}\n"
          }
        ]
      }
    ],
    "git": {
      "headUnchanged": true,
      "clean": true
    }
  },
  {
    "id": "chef-setup-recipient-change-returns-delivery-tasks",
    "description": "Changing household recipients through chef-setup returns the delivery tasks to re-create so Muse re-asks permission for the new addresses.",
    "command": [
      "node",
      "{skills}/chef-setup/scripts/setup.mjs",
      "set",
      "--household-recipients",
      "cook@example.com"
    ],
    "parse": "json",
    "assertions": [
      {
        "path": "$.status",
        "equals": "saved"
      },
      {
        "path": "$.side_effects",
        "equals": [
          "recreate-delivery-tasks"
        ]
      },
      {
        "path": "$.delivery_tasks.action",
        "equals": "recreate-delivery-tasks"
      },
      {
        "path": "$.delivery_tasks.recipients",
        "equals": [
          "cook@example.com"
        ]
      },
      {
        "path": "$.delivery_tasks.tasks[0].skill",
        "equals": "chef-shopping-lists"
      }
    ],
    "git": {
      "headUnchanged": true,
      "clean": true
    }
  },
  {
    "id": "chef-setup-other-setting-change-has-no-delivery-tasks",
    "description": "A settings change that leaves household recipients alone returns no delivery tasks.",
    "command": [
      "node",
      "{skills}/chef-setup/scripts/setup.mjs",
      "set",
      "--units",
      "metric"
    ],
    "parse": "json",
    "assertions": [
      {
        "path": "$.status",
        "equals": "saved"
      },
      {
        "path": "$.delivery_tasks",
        "absent": true
      }
    ],
    "git": {
      "clean": true
    }
  }
]

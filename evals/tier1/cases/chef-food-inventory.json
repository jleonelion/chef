[
  {
    "id": "chef-food-inventory-refuses-schema-mismatch",
    "description": "chef-food-inventory refuses to write when the data root's schema version differs and points to update Chef.",
    "seed": [
      {
        "path": "schema-version.json",
        "content": "{\"schema_version\":2}\n"
      }
    ],
    "command": [
      "node",
      "{skills}/chef-food-inventory/scripts/inventory.mjs",
      "edit",
      "--path",
      "fridge.dairy.whole_milk",
      "--amount",
      "2"
    ],
    "parse": "json",
    "expectedStatus": 2,
    "git": {
      "headUnchanged": true,
      "clean": true
    },
    "assertions": [
      {
        "path": "$.status",
        "equals": "refused"
      },
      {
        "path": "$.reason",
        "includes": "update Chef"
      },
      {
        "path": "$.changes",
        "absent": true
      }
    ],
    "files": [
      {
        "path": "data/food-inventory/current.json",
        "parse": "json",
        "assertions": [
          {
            "path": "$.fridge.dairy.whole_milk.amount",
            "equals": 1
          }
        ]
      }
    ]
  },
  {
    "id": "chef-food-inventory-receipt-text-yields-items",
    "description": "Receipt text becomes inventory items: a new item is placed by name, a targeted item is added to, and the rollup page is regenerated.",
    "seed": [
      {
        "path": "../receipt.txt",
        "seedFile": "evals/tier1/inputs/chef-food-inventory-receipt-text-yields-items/receipt.txt"
      }
    ],
    "command": [
      "node",
      "{skills}/chef-food-inventory/scripts/inventory.mjs",
      "add-receipt",
      "--transcript-file",
      "{data_root}/../receipt.txt",
      "--source",
      "text",
      "--date",
      "2026-01-15"
    ],
    "parse": "json",
    "assertions": [
      {
        "path": "$.status",
        "equals": "added"
      },
      {
        "path": "$.changes[*].path",
        "equals": [
          "pantry.produce.bananas",
          "fridge.dairy.whole_milk"
        ]
      }
    ],
    "files": [
      {
        "path": "data/food-inventory/current.json",
        "parse": "json",
        "assertions": [
          {
            "path": "$.pantry.produce.bananas.amount",
            "equals": 2
          },
          {
            "path": "$.pantry.produce.bananas.unit",
            "equals": "lb"
          },
          {
            "path": "$.fridge.dairy.whole_milk.amount",
            "equals": 2
          }
        ]
      },
      {
        "path": "knowledge/wiki/household/current-inventory.md",
        "assertions": [
          {
            "path": "$.content",
            "includes": "- bananas: 2 lb"
          },
          {
            "path": "$.content",
            "includes": "- whole milk: 8 qt (expires 2026-01-21)"
          }
        ]
      }
    ],
    "git": {
      "clean": true
    }
  },
  {
    "id": "chef-food-inventory-untrusted-sender-refused",
    "description": "A receipt email from a sender not in trusted_receipt_senders is refused and nothing changes, even when the display name looks trusted.",
    "seed": [
      {
        "path": "settings.json",
        "content": "{\"settings_version\": 1, \"trusted_receipt_senders\": [\"receipts@example.com\"]}\n"
      },
      {
        "path": "../receipt.txt",
        "seedFile": "evals/tier1/inputs/chef-food-inventory-untrusted-sender-refused/receipt.txt"
      }
    ],
    "command": [
      "node",
      "{skills}/chef-food-inventory/scripts/inventory.mjs",
      "add-receipt",
      "--transcript-file",
      "{data_root}/../receipt.txt",
      "--source",
      "email",
      "--from",
      "\"receipts@example.com\" <orders@example.com>",
      "--receipt-id",
      "<r1@example.com>"
    ],
    "parse": "json",
    "expectedStatus": 2,
    "assertions": [
      {
        "path": "$.status",
        "equals": "refused"
      },
      {
        "path": "$.reason",
        "includes": "orders@example.com is not a trusted receipt sender"
      },
      {
        "path": "$.changes",
        "absent": true
      }
    ],
    "files": [
      {
        "path": "data/food-inventory/current.json",
        "parse": "json",
        "assertions": [
          {
            "path": "$.fridge.dairy.whole_milk.amount",
            "equals": 1
          },
          {
            "path": "$.pantry.produce.bananas",
            "absent": true
          }
        ]
      }
    ],
    "git": {
      "headUnchanged": true,
      "clean": true
    }
  },
  {
    "id": "chef-food-inventory-receipt-intake-off-refused",

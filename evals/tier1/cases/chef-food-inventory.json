  {
    "id": "chef-food-inventory-trusted-sender-accepted",
    "description": "A trusted sender whose domain the mail provider authenticated passes the gate case-insensitively.",
    "seed": [
      {
        "path": "settings.json",
        "content": "{\"settings_version\": 1, \"trusted_receipt_senders\": [\"receipts@example.com\"]}\n"
      }
    ],
    "command": [
      "node",
      "{skills}/chef-food-inventory/scripts/inventory.mjs",

  {
    "id": "chef-food-inventory-cook-deduction-is-idempotent",
    "description": "A cook event scales and converts recipe quantities, and retrying its deduction id changes inventory only once.",
    "steps": [
      {
        "command": [
          "node",
          "{skills}/chef-food-inventory/scripts/inventory.mjs",
          "edit",
          "--path",
          "pantry.grains.spaghetti",
          "--amount",
          "1",
          "--unit",
          "kg"
        ]
      },
      {
        "command": [
          "node",
          "{skills}/chef-food-inventory/scripts/inventory.mjs",
          "deduct",
          "--recipe",
          "lemon-garlic-pasta",
          "--servings",
          "5",
          "--deduction-id",
          "cook-lemon-pasta-20260115"
        ]
      }
    ],
    "command": [
      "node",
      "{skills}/chef-food-inventory/scripts/inventory.mjs",
      "deduct",
      "--recipe",
      "lemon-garlic-pasta",
      "--servings",
      "5",
      "--deduction-id",
      "cook-lemon-pasta-20260115"
    ],
    "parse": "json",
    "assertions": [
      {
        "path": "$.status",
        "equals": "duplicate"
      },
      {
        "path": "$.deduction_id",
        "equals": "cook-lemon-pasta-20260115"
      }
    ],
    "files": [
      {
        "path": "data/food-inventory/current.json",
        "parse": "json",
        "assertions": [
          {
            "path": "$.pantry.grains.spaghetti.amount",
            "equals": 0.5
          }
        ]
      },
      {
        "path": "data/food-inventory/audit.jsonl",
        "assertions": [
          {
            "path": "$.content",
            "includes": "\"deduction_id\":\"cook-lemon-pasta-20260115\""
          }
        ]
      }
    ],
    "git": {
      "clean": true
    }
  },
  {
    "id": "chef-food-inventory-cook-deduction-reports-count-unit-mismatch",
    "description": "A cook event reports a bunch-vs-each mismatch and leaves inventory unchanged.",
    "seed": [
      {
        "path": "knowledge/wiki/recipes/spinach-salad.md",
        "seedFile": "evals/tier1/inputs/chef-food-inventory-cook-deduction-reports-count-unit-mismatch/spinach-salad.md"
      }
    ],
    "command": [
      "node",
      "{skills}/chef-food-inventory/scripts/inventory.mjs",
      "deduct",
      "--recipe",
      "spinach-salad",
      "--servings",
      "2",
      "--deduction-id",
      "cook-spinach-salad-20260115"
    ],
    "parse": "json",
    "expectedStatus": 2,
    "git": {
      "headUnchanged": true,
      "clean": true
    },
    "assertions": [
      {
        "path": "$.status",
        "equals": "invalid-input"
      },
      {
        "path": "$.unit_mismatches[0].recipe_unit",
        "equals": "each"
      },
      {
        "path": "$.unit_mismatches[0].inventory_unit",
        "equals": "bunch"
      },
      {
        "path": "$.unit_mismatches[0].reason",
        "equals": "cannot convert each to bunch"
      }
    ],
    "files": [
      {
        "path": "data/food-inventory/current.json",
        "parse": "json",
        "assertions": [
          {
            "path": "$.fridge.produce.spinach.amount",
            "equals": 1
          },
          {
            "path": "$.fridge.produce.spinach.unit",
            "equals": "bunch"
          }
        ]
      }
    ]
  },

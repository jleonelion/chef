{
  "name": "chef",
  "private": true,
  "type": "module",
  "description": "Source, build and tests for the Chef skill pack. Built skills live in plugins/chef/skills.",
  "scripts": {
    "build": "bun scripts/build.mjs",
    "check": "bun run lint && bun run test && bun run tier1 && bun run migrations",
    "lint": "node scripts/lint-skills.mjs",
    "test": "node --test",
    "tier1": "node evals/tier1/run.mjs",
    "migrations": "node evals/migration-regression.mjs",
    "smoke": "node scripts/bundle-smoke.mjs",
    "hygiene": "node scripts/hygiene.mjs",
    "agentic": "node evals/agentic/run.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "pdf-lib": "1.17.1",
    "yaml": "2.9.1"
  }
}

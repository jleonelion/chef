{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jleonelion/chef/schemas/feedback/reproduction-case.v1.json",
  "title": "Chef reproduction case v1",
  "description": "A maintainer-written case that reproduces what one or more feedback reports describe, using synthetic data only. Holds no text from any report. Stored as evals/repro/<case_id>.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "class", "skill_ids", "chef_version_observed", "provenance_refs", "created_on", "scenario", "steps", "expected", "target", "reviewers"],
  "properties": {
    "schema_version": { "const": 1 },
    "case_id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 80 },
    "class": { "enum": ["defect", "behavior_change"] },
    "skill_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^chef-[a-z0-9-]+$" }
    },
    "chef_version_observed": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "provenance_refs": {
      "description": "Random per-case IDs minted in feedback intake; never a report_id. Empty for a case with no report behind it.",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,64}$" }
    },
    "created_on": {
      "description": "UTC date the case was written; a known_failure marker on its test expires 60 days later.",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture"],
      "properties": {
        "fixture": {
          "description": "Base synthetic fixture under fixtures/; the test row's seed overlay goes on top.",
          "type": "string",
          "pattern": "^(data-root|schema-v[1-9][0-9]*)$"
        },
        "test": {
          "description": "The test that reproduces the case: <suite>:<row id>, or docs:<repo path>.",
          "type": "string",
          "pattern": "^((tier1|agentic|conformance):[a-z0-9]+(-[a-z0-9]+)*|docs:[^\\s]+)$"
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "expected": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "target": { "enum": ["deterministic-test", "agentic-eval", "docs", "none"] },
    "reviewers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maintainer", "overlap_review"],
      "properties": {
        "maintainer": { "type": "string", "pattern": "^[A-Za-z0-9](-?[A-Za-z0-9]){0,38}$" },
        "overlap_review": { "const": "pass" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "target": { "const": "deterministic-test" } } },
      "then": { "properties": { "scenario": { "type": "object", "required": ["test"], "properties": { "test": { "type": "string", "pattern": "^(tier1|conformance):" } } } } }
    },
    {
      "if": { "properties": { "target": { "const": "agentic-eval" } } },
      "then": { "properties": { "scenario": { "type": "object", "required": ["test"], "properties": { "test": { "type": "string", "pattern": "^agentic:" } } } } }
    },
    {
      "if": { "properties": { "target": { "const": "docs" } } },
      "then": { "properties": { "scenario": { "type": "object", "required": ["test"], "properties": { "test": { "type": "string", "pattern": "^docs:" } } } } }
    },
    {
      "if": { "properties": { "target": { "const": "none" } } },
      "then": { "properties": { "scenario": { "type": "object", "not": { "type": "object", "required": ["test"] } } } }
    }
  ]
}

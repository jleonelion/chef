{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jleonelion/chef/schemas/evals/agentic-row.v1.json",
  "title": "Chef agentic eval row v1",
  "description": "One row in evals/agentic/rows.json. Keys are those read by evals/agentic/run.mjs and report.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "flow", "description", "turns", "skills", "files", "git"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "flow": { "enum": ["core", "should-not-act"] },
    "description": { "type": "string", "minLength": 1 },
    "turns": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "responses": { "type": "array", "items": { "$ref": "#/$defs/assertions" } },
    "skills": { "$ref": "#/$defs/skillNames" },
    "forbidSkills": { "$ref": "#/$defs/skillNames" },
    "seed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "content"],
        "properties": { "path": { "type": "string", "minLength": 1 }, "content": {} }
      }
    },
    "scripts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": { "$ref": "#/$defs/scriptPaths" },
        "forbidden": { "$ref": "#/$defs/scriptPaths" },
        "max": { "type": "object", "propertyNames": { "pattern": "^scripts/[^/]+$" }, "additionalProperties": { "type": "integer", "minimum": 0 } }
      }
    },
    "setup": { "$ref": "#/$defs/steps" },
    "after": { "$ref": "#/$defs/steps" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "absent": { "type": "boolean" },
          "count": { "type": "integer", "minimum": 0 },
          "parse": { "enum": ["text", "json"] },
          "assertions": { "$ref": "#/$defs/assertions" }
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "headUnchanged": { "type": "boolean" }, "clean": { "type": "boolean" } }
    },
    "repro": { "$ref": "#/$defs/id" },
    "known_failure": { "$ref": "#/$defs/id" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)+$", "maxLength": 100 },
    "scriptPaths": { "type": "array", "items": { "type": "string", "pattern": "^scripts/[^/]+$" } },
    "skillNames": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "assertions": { "type": "array", "items": { "$ref": "assertion.v1.json" } },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command"],
        "properties": {
          "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "stdin": {},
          "assertions": { "$ref": "#/$defs/assertions" }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jleonelion/chef/schemas/evals/agentic-row.v1.json",
  "title": "Chef agentic eval row v1",
  "description": "One row in evals/agentic/rows.json. Keys are those read by evals/agentic/run.mjs and report.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "flow", "description", "turns", "skills", "files", "git", "gate"],
  "dependentRequired": {
    "known_failure": ["expect_failure"],
    "expect_failure": ["known_failure"]
  },
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "gate": { "type": "boolean", "description": "Whether this row blocks scheduled and patch-release agentic checks." },
    "candidate": { "type": "boolean", "description": "Whether this row is run in scheduled checks to collect promotion evidence without blocking." },
    "flow": { "enum": ["core", "should-not-act"] },
    "description": { "type": "string", "minLength": 1 },
    "turns": { "type": "array", "minItems": 1, "items": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "object", "additionalProperties": false, "required": ["turnFile"], "properties": { "turnFile": { "$ref": "#/$defs/inputPath" } } }] } },
    "responses": { "type": "array", "items": { "$ref": "#/$defs/assertions" } },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected", "threshold"],
      "properties": {
        "expected": { "type": "string", "minLength": 1 },
        "threshold": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "skills": { "$ref": "#/$defs/skillNames" },
    "forbidSkills": { "$ref": "#/$defs/skillNames" },
    "seed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "oneOf": [{ "required": ["content"] }, { "required": ["seedFile"] }],
        "properties": { "path": { "type": "string", "minLength": 1 }, "content": {}, "seedFile": { "$ref": "#/$defs/inputPath" } }
      }
    },
    "scripts": { "$ref": "#/$defs/scriptChecks" },
    "turnScripts": { "type": "array", "items": { "$ref": "#/$defs/scriptChecks" } },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "forbidden": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "setup": { "$ref": "#/$defs/steps" },
    "after": { "$ref": "#/$defs/steps" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "absent": { "type": "boolean" },
          "pattern": { "type": "string", "description": "Filter count checks by a regular expression over relative file names; assertions apply to each matched file's text." },
          "count": {
            "oneOf": [
              { "type": "integer", "minimum": 0 },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["baseline", "delta"],
                "properties": { "baseline": { "type": "integer", "minimum": 0 }, "delta": { "type": "integer", "minimum": 0 } }
              }
            ]
          },
          "parse": { "enum": ["text", "json", "pdf"] },
          "assertions": { "$ref": "#/$defs/assertions" }
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "headUnchanged": { "type": "boolean" }, "clean": { "type": "boolean" } }
    },
    "grounding": {
      "type": "object",
      "description": "Fixture facts this item relies on; evals/grounding.test.mjs checks each exists in fixtures/data-root.",
      "additionalProperties": false,
      "properties": {
        "recipes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "inventory": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "mealPlans": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" } }
      }
    },
    "pair": { "description": "Flip pair id: exactly two rows share it and the same turns; they differ in seed/setup so the checks show opposite outcomes.", "$ref": "#/$defs/id" },
    "repro": { "$ref": "#/$defs/id" },
    "known_failure": { "$ref": "#/$defs/id" },
    "expect_failure": { "enum": ["response", "skills", "scripts", "tools", "files", "git-state", "post-run"] }
  },
  "$defs": {
    "inputPath": { "type": "string", "pattern": "^evals/(tier1|agentic)/inputs/([^./][^/]*/)*[^./][^/]*$" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)+$", "maxLength": 100 },
    "scriptPaths": { "type": "array", "items": { "type": "string", "pattern": "^scripts/[^/]+$" } },
    "scriptCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script", "args"],
      "properties": {
        "script": { "type": "string", "pattern": "^scripts/[^/]+$" },
        "args": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "scriptChecks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": { "$ref": "#/$defs/scriptPaths" },
        "forbidden": { "$ref": "#/$defs/scriptPaths" },
        "max": { "type": "object", "propertyNames": { "pattern": "^scripts/[^/]+$" }, "additionalProperties": { "type": "integer", "minimum": 0 } },
        "requiredCalls": { "type": "array", "items": { "$ref": "#/$defs/scriptCall" } },
        "forbiddenCalls": { "type": "array", "items": { "$ref": "#/$defs/scriptCall" } }
      }
    },
    "skillNames": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "assertions": { "type": "array", "items": { "$ref": "assertion.v1.json" } },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command"],
        "properties": {
          "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "stdin": {},
          "assertions": { "$ref": "#/$defs/assertions" }
        }
      }
    }
  }
}

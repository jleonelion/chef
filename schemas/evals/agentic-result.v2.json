{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jleonelion/chef/schemas/evals/agentic-result.v2.json",
  "title": "Chef agentic result format 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["suite", "format", "date", "commit", "commit_dirty", "plugin_version", "dataset_sha", "fixture_sha", "harness", "selected_rows", "rows_selected", "rows_total", "models", "reps", "passed", "cost_usd", "rows"],
  "properties": {
    "suite": { "const": "chef-agentic" },
    "format": { "const": 2 },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "commit_dirty": { "type": "boolean" },
    "plugin_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "dataset_sha": { "$ref": "#/$defs/sha256" },
    "fixture_sha": { "$ref": "#/$defs/sha256" },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "launcherVersion", "cliVersion"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "launcherVersion": { "type": "integer", "minimum": 1 },
        "cliVersion": { "type": "string", "minLength": 1 }
      }
    },
    "selected_rows": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "rows_selected": { "type": "integer", "minimum": 0 },
    "rows_total": { "type": "integer", "minimum": 0 },
    "models": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "reps": { "type": "integer", "minimum": 1 },
    "passed": { "type": "boolean" },
    "cost_usd": { "type": "number", "minimum": 0 },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "flow", "passes", "pass", "failures", "runs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "flow": { "type": "string", "minLength": 1 },
          "passes": { "type": "string", "pattern": "^[0-9]+/[0-9]+$" },
          "pass": { "type": "boolean" },
          "known_failure": { "type": "string", "minLength": 1 },
          "failures": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["rep", "error"],
              "properties": { "rep": { "type": "integer", "minimum": 1 }, "error": { "type": "string", "minLength": 1 } }
            }
          },
          "runs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["rep", "pass", "skills", "error"],
              "properties": {
                "rep": { "type": "integer", "minimum": 1 },
                "pass": { "type": "boolean" },
                "skills": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "error": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
